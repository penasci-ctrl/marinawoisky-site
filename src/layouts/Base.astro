---
import '../styles/global.css';
import { UI, href, t } from '../lib/i18n.js';
import { imgUrl } from '../lib/img.js';
import { getContent } from '../lib/content.js';

/**
 * Moldura comum a todas as páginas: nome no topo, PT/EN, menu no canto inferior esquerdo.
 * section: 'works' | 'exhibitions' | 'publications' | 'texts' | 'about'
 * path: caminho desta página sem o prefixo de idioma (para o seletor PT/EN)
 */
const { lang = 'pt', section, path = '/', title, description, image, intro = false } = Astro.props;
const ui = UI[lang];
const { settings } = await getContent();
const siteTitle = 'Marina Woisky';
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const desc = description || t(settings?.description, lang) || siteTitle;
const shareImg = image || settings?.shareImage;
const ogImage = shareImg ? new URL(imgUrl(shareImg, 1200), Astro.site).href : undefined;
const canonical = new URL(href(lang, path), Astro.site).href;
const altPt = new URL(href('pt', path), Astro.site).href;
const altEn = new URL(href('en', path), Astro.site).href;

const SECTIONS = [
  ['works', '/obras'],
  ['exhibitions', '/exposicoes'],
  ['publications', '/publicacoes'],
  ['about', '/sobre'],
];
const current = SECTIONS.find(([k]) => k === section);
const others = SECTIONS.filter(([k]) => k !== section);
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'pt-BR'}>
<head>
  <meta charset="utf-8" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="pt-BR" href={altPt} />
  <link rel="alternate" hreflang="en" href={altEn} />
  <link rel="alternate" hreflang="x-default" href={altPt} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteTitle} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rosarivo:ital@0;1&family=Noto+Sans+Symbols+2&display=swap" />
  <slot name="head" />
</head>
<body class={intro ? 'is-intro' : ''}>
  <!-- Tratamento "tinta no tecido": a borda das letras roída pela trama (nome, menu, títulos) -->
  <svg width="0" height="0" style="position: absolute" aria-hidden="true" focusable="false">
    <filter id="ink" x="-5%" y="-30%" width="110%" height="160%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.95" numOctaves="2" seed="7" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="1.4" xChannelSelector="R" yChannelSelector="G" result="d" />
      <feGaussianBlur in="d" stdDeviation="0.35" result="b" />
      <feComponentTransfer in="b"><feFuncA type="table" tableValues="0 0 0.7 1 1" /></feComponentTransfer>
    </filter>
  </svg>

  <a class="site-name frame dif" href={href(lang, '/')} data-to-top={section === 'works' ? '' : undefined}>Marina Woisky</a>

  <div class="lang frame dif chrome">
    <a href={href('pt', path)} lang="pt-BR" aria-current={lang === 'pt' ? 'true' : 'false'}>PT</a>
    <span aria-hidden="true">/</span>
    <a href={href('en', path)} lang="en" aria-current={lang === 'en' ? 'true' : 'false'}>EN</a>
  </div>

  <nav class="menu frame dif chrome" aria-label={ui.menu}>
    {current && (
      <a class="menu-current" href={href(lang, current[1])} aria-expanded="false" data-menu-toggle>{ui[current[0]]}</a>
    )}
    <ul>
      {others.map(([k, p]) => <li><a href={href(lang, p)}>{ui[k]}</a></li>)}
    </ul>
  </nav>

  <!-- só no celular: botão "Menu" que abre a lista em tela cheia -->
  <button class="menu-btn frame dif chrome" type="button" aria-expanded="false" aria-controls="menu-sheet" data-menu-open>{ui.menu}</button>
  <div class="menu-sheet" id="menu-sheet" hidden data-menu-sheet>
    <button class="menu-close frame" type="button" data-menu-close>{ui.close}</button>
    <ul>
      {SECTIONS.map(([k, p]) => <li><a href={href(lang, p)} aria-current={k === section ? 'page' : undefined}>{ui[k]}</a></li>)}
    </ul>
    <div class="menu-lang frame">
      <a href={href('pt', path)} lang="pt-BR" aria-current={lang === 'pt' ? 'true' : 'false'}>PT</a>
      <span aria-hidden="true">/</span>
      <a href={href('en', path)} lang="en" aria-current={lang === 'en' ? 'true' : 'false'}>EN</a>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <script>
    // Fotos entram com fade suave ao terminar de carregar (exceto as da galeria da obra, que já têm o próprio fade)
    document.querySelectorAll('main img:not(.work-stage img)').forEach((img) => {
      const show = () => img.classList.add('is-in');
      img.classList.add('fade');
      if (img.complete && img.naturalWidth) requestAnimationFrame(show);
      else { img.addEventListener('load', show, { once: true }); img.addEventListener('error', show, { once: true }); }
    });
    // Menu: no computador abre com o mouse (CSS); no toque, abre e fecha com um toque
    const menu = document.querySelector('.menu');
    const btn = document.querySelector('[data-menu-toggle]');
    if (menu && btn) {
      btn.addEventListener('click', (e) => {
        // no computador, o item atual é um link para o começo da seção (ex.: Obras, vindo de uma obra)
        if (matchMedia('(hover: hover)').matches) {
          if (location.pathname === btn.getAttribute('href')) { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); }
          return;
        }
        e.preventDefault();
        const open = menu.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target)) { menu.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); }
      });
    }
    // Menu do celular: abre/fecha a lista em tela cheia
    const sheet = document.querySelector('[data-menu-sheet]');
    const openBtn = document.querySelector('[data-menu-open]');
    const setMenu = (open) => {
      sheet.hidden = !open;
      openBtn.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('menu-open', open);
    };
    openBtn?.addEventListener('click', () => setMenu(true));
    document.querySelector('[data-menu-close]')?.addEventListener('click', () => { setMenu(false); openBtn.focus(); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sheet.hidden) setMenu(false); });
    // Na home, o nome volta suave para a abertura
    document.querySelector('[data-to-top]')?.addEventListener('click', (e) => {
      if (location.pathname === e.currentTarget.getAttribute('href')) { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); }
    });
  </script>
</body>
</html>
